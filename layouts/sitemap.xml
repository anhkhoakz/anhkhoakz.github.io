{{- $pages := slice -}}
{{- range site.Pages -}}
  {{- if and (or (eq .Kind "home") (eq .Kind "section") (eq .Kind "page")) (not .Sitemap.Disable) (not .Params.noindex) (not .Params.unlisted) -}}
    {{- $pages = $pages | append . -}}
  {{- end -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{- range $pages }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- with .Lastmod }}<lastmod>{{ .Format "2006-01-02T15:04:05Z07:00" }}</lastmod>{{ end }}
  </url>
{{- end }}
</urlset>
